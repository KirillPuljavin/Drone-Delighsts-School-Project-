# ---- build the Vite SPA ----
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# same-origin API path; Caddy proxies /api -> json-server
ENV VITE_API_URL=/api
ENV VITE_USE_LOCAL=false
RUN npm run build

# ---- serve static ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# SPA fallback so react-router deep links work
RUN printf 'server {\n listen 80;\n root /usr/share/nginx/html;\n index index.html;\n location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
